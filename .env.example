# Kopieer naar .env.local voor lokaal gebruik, of zet deze waarden in Vercel:
# Settings → Environment Variables. Nooit echte waarden in de repo.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Alleen voor de server. Nooit delen en nooit een NEXT_PUBLIC_-naam geven.
# Wordt alleen gebruikt voor accountbeheer, het serveren van agendafeeds, de geplande taak
# voor mails en het volledig verwijderen van een medewerker.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optioneel: vaste basis-URL voor agendalinks en de link in mails, bijvoorbeeld https://planbord.vercel.app
# Leeg = het adres waarop de app draait.
SITE_URL=

# Mails (fase 3), via SMTP. Voor Google Workspace: smtp.gmail.com, poort 465 en een app-wachtwoord.
# Zonder deze waarden mislukt het versturen; de rest van de app werkt gewoon.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=planbord@voorbeeld.nl
SMTP_PASSWORD=
MAIL_FROM="Planbord <planbord@voorbeeld.nl>"

# Geheim voor de geplande taak (herinneringen en opnieuw proberen): minstens 32 willekeurige tekens.
# Bijvoorbeeld: openssl rand -base64 32
CRON_SECRET=

# Pushmeldingen (fase 4). Maak het sleutelpaar in Planbord: Beheer → Instellingen → Sleutels voor
# pushmeldingen. Zonder deze waarden gaan er geen pushmeldingen weg; mails werken gewoon.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:planbord@voorbeeld.nl
