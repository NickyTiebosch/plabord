# Kopieer naar .env.local voor lokaal gebruik, of zet deze waarden in Netlify:
# Site configuration → Environment variables. Nooit echte waarden in de repo.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Alleen voor de server. Nooit delen en nooit een NEXT_PUBLIC_-naam geven.
# Wordt alleen gebruikt voor accountbeheer en het serveren van agendafeeds.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optioneel: vaste basis-URL voor agendalinks, bijvoorbeeld https://planbord.netlify.app
# Leeg = het adres waarop de app draait.
SITE_URL=
